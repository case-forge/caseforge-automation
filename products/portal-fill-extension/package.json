{
  "name": "portal-fill-extension",
  "private": true,
  "version": "0.0.1",
  "description": "Prototype: fill one page of a local mock of the court portal from a one-matter answers export. Never run against HMCTS.",
  "type": "module",
  "scripts": {
    "build:mock": "node mock/build.mjs",
    "mock": "node mock/build.mjs && node mock/serve.mjs",
    "test": "node mock/build.mjs && node --test test/*.test.mjs",
    "test:signing": "node --test test/signing.test.mjs"
  },
  "devDependencies": {
    "@angular/common": "20.3.31",
    "@angular/compiler": "20.3.31",
    "@angular/core": "20.3.31",
    "@angular/forms": "20.3.31",
    "@angular/platform-browser": "20.3.31",
    "esbuild": "0.25.10",
    "playwright": "1.63.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.15.1"
  }
}
