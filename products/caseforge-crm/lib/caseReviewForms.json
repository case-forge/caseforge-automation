        },
        {
          "key": "legal",
          "title": "Legal Review",
          "person_only": true,
          "rows": [
            {"key": "r_legal_issues", "label": "Legal issues correctly identified?", "kind": "ynna"},
            {"key": "r_legal_advice", "label": "Correct legal advice given?", "kind": "ynna"},
            {"key": "r_legal_conduct", "label": "Case conducted competently and expeditiously?", "kind": "ynna"},
            {"key": "r_legal_objectives", "label": "Client's objectives achieved?", "kind": "ynna"},
            {"key": "r_legal_new_aspects", "label": "Any new legal aspects?", "kind": "ynna"},
            {"key": "r_legal_comments", "label": "Additional comments on the legal issues (please do not leave blank)", "kind": "longtext"},
            {"key": "r_corrective_action", "label": "Corrective action identified (None / details)", "kind": "longtext"},
            {"key": "r_corrective_by", "label": "Corrective action required by", "kind": "date", "optional": true},
            {"key": "r_corrective_done", "label": "Corrective action completed on", "kind": "date", "optional": true},
            {"key": "r_corrective_checked_by", "label": "Corrective action & review checked by (legal reviewer)", "kind": "text", "optional": true},
            {"key": "r_corrective_checked_on", "label": "Corrective action & review checked on", "kind": "date", "optional": true}
          ]
        }
      ]
    },
    {
      "key": "summary",
      "title": "File Summary Sheet",
      "note": "Initial AND DATE boxes when completing tasks, or mark as not applicable.",
      "sections": [
        {
          "key": "summary_header",
          "title": "File details",
          "rows": [
            {"key": "s_client_name", "label": "Full client name", "kind": "text"},
            {"key": "s_fee_earner", "label": "Fee earner name", "kind": "text"},
            {"key": "s_matter_number", "label": "Client matter number", "kind": "text"},
            {"key": "s_summary", "label": "Summary of matter", "kind": "longtext"}
          ]
        },
        {
          "key": "commencement",
          "title": "Commencement",
          "rows": [
            {"key": "s_conflict", "label": "Conflict of interest checked and cleared (yes/no, by who, date)", "kind": "signoff", "options": [["yes", "Yes"], ["no", "No"]], "na": false},
            {"key": "s_source", "label": "Source of client or lender", "kind": "text"},
            {"key": "s_cdd", "label": "Money laundering: client due diligence completed, ID checked and copy filed", "kind": "signoff"},
            {"key": "s_tdd", "label": "Money laundering: transaction due diligence", "kind": "signoff"},
            {"key": "s_ccl_sent", "label": "Client care letter sent", "kind": "signoff"},
            {"key": "s_tob_sent", "label": "Terms of business sent", "kind": "signoff"},
            {"key": "s_tob_accepted", "label": "Terms of business accepted", "kind": "signoff"},
            {"key": "s_risk_assessment", "label": "Initial operational risk assessment & sufficient benefit test carried out", "kind": "signoff"},
            {"key": "s_risk_assigned", "label": "Operational risk assigned", "kind": "choice", "options": [["normal", "Normal"], ["high", "High"]]},
            {"key": "s_risk_high", "label": "If high, inform the risk manager and note special arrangements", "kind": "longtext", "optional": true}
          ]
        },
        {
          "key": "progress",
          "title": "Progress",
          "rows": [
            {"key": "s_key_dates_backup", "label": "Key dates reminders recorded in backup system", "kind": "choice", "options": [["outlook_calendar", "Outlook Calendar"], ["outlook_tasks", "Outlook Tasks"], ["desk_diary", "Desk Diary"], ["other", "Other"]]},
            {"key": "s_key_dates", "label": "Key dates (list)", "kind": "longtext"},
            {"key": "s_status", "label": "Status tracking (description and date completed, for example each hearing)", "kind": "longtext"}
          ]
        },
        {
          "key": "conclusion",
          "title": "Conclusion",
          "rows": [
            {"key": "s_undertakings", "label": "All undertakings discharged", "kind": "signoff"},
            {"key": "s_complaints", "label": "Any complaints dealt with under the complaints procedure", "kind": "signoff"},
            {"key": "s_fees_paid", "label": "All outstanding fees and disbursements paid", "kind": "signoff"},
            {"key": "s_concluding_risk", "label": "Concluding risk assessment carried out", "kind": "signoff"},
            {"key": "s_risk_report", "label": "Report made to risk manager", "kind": "yn"},
            {"key": "s_adviser_evaluation", "label": "Expert/counsel/other adviser evaluation entered in register", "kind": "signoff"},
            {"key": "s_closed", "label": "Closed on system", "kind": "signoff"},
            {"key": "s_archived_date", "label": "Archived date", "kind": "date", "optional": true},
            {"key": "s_archive_number", "label": "Archive number", "kind": "text", "optional": true},
            {"key": "s_destroy_date", "label": "Destroy date", "kind": "date", "optional": true}
          ]
        }
      ]
