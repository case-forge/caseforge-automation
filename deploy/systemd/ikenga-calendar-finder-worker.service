[Unit]
StartLimitIntervalSec=0
StartLimitBurst=10
Description=CaseForge calendar-finder webhook worker (drains the mail-intake fan-out)
After=network-online.target
Wants=network-online.target

[Service]
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
Environment=HOME=/root
Type=simple
WorkingDirectory=/root/caseforge-automation
Environment=CASEFORGE_RUNTIME_LABEL=calendar-finder-worker
ExecStart=/bin/bash /root/caseforge-automation/tools/run-calendar-finder-worker.sh
Restart=always
MemoryHigh=1500M
MemoryMax=2500M
RestartSec=5
RestartSteps=6
RestartMaxDelaySec=300

[Install]
WantedBy=multi-user.target
